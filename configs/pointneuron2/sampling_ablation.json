{
  "epochs": 5,
  "arms": [
    {"name": "random", "strategy": "random", "chamfer_weight": 0.0},
    {"name": "learned_no_aux", "strategy": "learned", "chamfer_weight": 0.0},
    {"name": "learned_aux", "strategy": "learned", "chamfer_weight": 0.05}
  ],
  "cache_config": "configs/pointneuron2/sampling_training.json",
  "partition": "configs/pointneuron2/partition_seed0.json",
  "reconstruction": {
    "initializer": "geodesic",
    "graph_selection_mode": "adaptive_connected_coverage_nms",
    "graph_min_proposal_score": 0.85,
    "graph_nms_mode": "distance",
    "graph_nms_distance": 18,
    "graph_max_nodes": 128,
    "proposal_threshold_fraction": 0.2,
    "proposal_score_threshold": 0.5,
    "proposal_top_per_patch": 512,
    "proposal_global_top": 4096,
    "proposal_local_nms_radius": 8,
    "proposal_global_nms_radius": 12,
    "point_sample_strategy": "auto"
  }
}
